# Horalix View Environment Configuration
# ========================================
# Copy this file to `./.env` and update the values for your environment.
#
# Docker startup commands in this repo expect `./.env`.
# `./docker/.env` is supported but optional.
# For local backend development without Docker, copy to `./backend/.env`.
#
# Generate a secure SECRET_KEY:
#   Linux/macOS: openssl rand -hex 32
#   Windows:     python -c "import secrets; print(secrets.token_hex(32))"

# ============================================
# REQUIRED SETTINGS (must be configured)
# ============================================

# Security - CRITICAL: Generate a unique key for production!
# WARNING: Application will fail to start in production without a secure key.
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32

# ============================================
# ENVIRONMENT SETTINGS
# ============================================

# Environment mode: development, staging, production
# - development: Debug mode, default users created, relaxed validation
# - production: Strict validation, requires secure SECRET_KEY
ENVIRONMENT=development

# Demo data seeding (development only)
ENABLE_DEMO_DATA=false

# Debug mode (only enable in development)
DEBUG=true

# ============================================
# APPLICATION SETTINGS
# ============================================

APP_NAME=Horalix View
APP_VERSION=1.0.0

# Server settings
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ============================================
# DATABASE SETTINGS
# ============================================

# For Docker: Use 'postgres' as host (Docker service name)
# For local: Use 'localhost'
DB_HOST=localhost
DB_PORT=5432
DB_USER=horalix
DB_PASSWORD=horalix
DB_NAME=horalix_view

# Complete Database URL (overrides individual settings if set)
# For Docker: postgresql+asyncpg://horalix:horalix@postgres:5432/horalix_view
# For local:  postgresql+asyncpg://horalix:horalix@localhost:5432/horalix_view
DATABASE_URL=postgresql+asyncpg://horalix:horalix@localhost:5432/horalix_view

# ============================================
# REDIS SETTINGS
# ============================================

# For Docker: Use 'redis' as host (Docker service name)
# For local: Use 'localhost'
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Complete Redis URL (overrides individual settings if set)
# For Docker: redis://redis:6379/0
# For local:  redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ============================================
# DICOM SETTINGS
# ============================================

DICOM_AE_TITLE=HORALIX_VIEW
DICOM_PORT=11112
DICOM_STORAGE_DIR=./storage/dicom
DICOM_MAX_UPLOAD_SIZE_GB=10

# ============================================
# AI MODEL SETTINGS
# ============================================

# Directory where model weights are stored
AI_MODELS_DIR=./models
# Horalix AI bundle directory (PanEcho/EchoPrime/EchoNetDynamic/Measurements)
AI_HORALIX_AI_MODELS_DIR=./models/horalix_ai
# Host path for Docker bind-mount (portable default for this repo layout)
HORALIX_AI_MODELS_HOST_PATH=../models/horalix_ai
# Directory where model outputs (masks, reports) are stored
AI_RESULTS_DIR=./results

# Device for inference: 'cpu', 'cuda', 'cuda:0', or 'cuda:1'
# Default is CPU for first-run compatibility on non-NVIDIA machines.
AI_DEVICE=cpu

# PyTorch wheel index for Docker builds
# CPU: https://download.pytorch.org/whl/cpu
# GPU: https://download.pytorch.org/whl/cu124
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# GPU visibility settings for Docker (NVIDIA Container Toolkit required for GPU mode)
# CPU:        NVIDIA_VISIBLE_DEVICES=void, CUDA_VISIBLE_DEVICES=
# Single GPU: NVIDIA_VISIBLE_DEVICES=all,  CUDA_VISIBLE_DEVICES=0
# Dual GPU:   NVIDIA_VISIBLE_DEVICES=all,  CUDA_VISIBLE_DEVICES=0,1
NVIDIA_VISIBLE_DEVICES=void
NVIDIA_DRIVER_CAPABILITIES=compute,utility
CUDA_VISIBLE_DEVICES=

# Worker-0 GPU reservation in docker-compose.yml
# CPU: 0
# GPU: 1
WORKER_0_GPU_COUNT=0

# Batch size (reduce if running out of memory)
AI_BATCH_SIZE=4

# Enable mixed precision (FP16) for faster inference
AI_MIXED_PRECISION=true

# Enable AI features
AI_ENABLED=true
# Enable Horalix AI suite (PanEcho/EchoPrime/EchoNetDynamic/Measurements)
AI_HORALIX_AI_ENABLED=true

# ============================================
# HORALIX AI WORKER POOL SETTINGS
# ============================================

# Number of worker processes
# CPU / Single GPU: 1
# Dual GPU (--profile gpu): 2
AI_HORALIX_AI_NUM_WORKERS=1

# Preload models at startup (eliminates first-inference latency)
AI_HORALIX_AI_PRELOAD=true

# Warmup models at startup (runs lightweight dummy inference)
AI_HORALIX_AI_WARMUP=false

# Worker polling interval (seconds)
AI_HORALIX_AI_WORKER_POLL_INTERVAL=1.0

# Worker job timeout (seconds)
AI_HORALIX_AI_WORKER_TIMEOUT=1800

# Retry attempts on timeout
AI_HORALIX_AI_RETRY_ATTEMPTS=1

# Job queue directory (shared volume for Docker)
AI_HORALIX_AI_JOB_QUEUE_DIR=./job_queue

# Enable specific model components
AI_HORALIX_AI_ENABLE_ECHONET_DYNAMIC=true
AI_HORALIX_AI_ENABLE_MEASUREMENTS_2D=true

# Model batch sizes (reduce if running out of GPU memory)
AI_HORALIX_AI_PANECHO_BATCH=8
AI_HORALIX_AI_ECHOPRIME_BATCH=4
AI_HORALIX_AI_MEASUREMENTS_BATCH=16
AI_HORALIX_AI_ECHONET_BATCH=32

# Frame cache settings (LRU cache for decoded DICOM frames)
AI_HORALIX_AI_CACHE_ENABLED=true
AI_HORALIX_AI_CACHE_MAX_SIZE_GB=10

# Mixed precision for Horalix AI (disable for maximum numerical fidelity)
AI_HORALIX_AI_MIXED_PRECISION=false

# Model weights paths (relative to AI_HORALIX_AI_MODELS_ROOT)
AI_HORALIX_AI_PANECHO_WEIGHTS=PanEcho/weights/panecho.pt
AI_HORALIX_AI_ECHOPRIME_ENCODER=EchoPrime/model_data/weights/echo_prime_encoder.pt
AI_HORALIX_AI_ECHOPRIME_TEXT_ENCODER=EchoPrime/model_data/weights/echo_prime_text_encoder.pt
AI_HORALIX_AI_VIEW_CLASSIFIER=EchoPrime/model_data/weights/view_classifier.pt
AI_HORALIX_AI_ECHONET_WEIGHTS=EchonetDynamic/output/segmentation/deeplabv3_resnet50_random/best.pt
AI_HORALIX_AI_MEASUREMENTS_DIR=measurements/weights

# EchoPrime view classification settings
AI_HORALIX_AI_VIEW_AGGREGATION=sampled_mean
AI_HORALIX_AI_VIEW_AGGREGATION_K=5

# ============================================

# Detection confidence threshold
AI_CONFIDENCE_THRESHOLD=0.5

# Maximum concurrent inference jobs
AI_MAX_CONCURRENT_JOBS=2

# External AI model commands (optional)
AI_EXTERNAL_TIMEOUT_SECONDS=900
AI_EXTERNAL_WORKDIR=
AI_ECHONET_MEASUREMENTS_CMD=python -m app.services.ai.external_runners.echonet_measurements
AI_GIGAPATH_CMD=python -m app.services.ai.external_runners.prov_gigapath
AI_HOVERNET_CMD=python -m app.services.ai.external_runners.hovernet
# Horalix AI runner (PanEcho/EchoPrime/EchoNetDynamic/Measurements)
AI_HORALIX_AI_COMMAND=python -m app.services.ai.external_runners.horalix_ai --model $$MODEL_NAME
# Optional: Hugging Face token for Prov-GigaPath weights
HF_TOKEN=

# ============================================
# SECURITY & COMPLIANCE
# ============================================

# JWT token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# HIPAA compliance mode
COMPLIANCE_HIPAA_MODE=true
COMPLIANCE_AUDIT_LOGGING_ENABLED=true
COMPLIANCE_ENCRYPTION_AT_REST=true

# ============================================
# CORS SETTINGS
# ============================================

# Allowed CORS origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
